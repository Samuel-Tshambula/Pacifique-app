# ─── Environnement de développement ─────────────────────────────────────────
# Ce fichier est ignoré par git (.gitignore).
# Pour la production, copiez .env.example et remplissez avec de vraies valeurs.

# Clé de chiffrement AES pour les fichiers JSON locaux
DATA_ENCRYPTION_KEY=pacifique_dev_enc_key_2026_replace_in_prod_abcdef1234567890

# URI MongoDB Atlas — laisser vide pour mode offline
# Remplacer par votre URI réelle pour activer la sync cloud
MONGODB_URI=mongodb+srv://daniel:test123@cluster0.5aylk.mongodb.net/pacifique?retryWrites=true&w=majority&connectTimeoutMS=60000&socketTimeoutMS=60000&serverSelectionTimeoutMS=60000

# Secret JWT — remplacer par une valeur aléatoire en production
JWT_SECRET=pacifique_dev_jwt_secret_2026_replace_in_prod_abcdef1234567890abcd

# Port du serveur
PORT=3001

# Environnement
NODE_ENV=development
